{
  "name": "promptlint-ai",
  "version": "1.0.0",
  "description": "Analyze. Score. Improve. Offline prompt linting and optional Groq AI evaluation.",
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "bin": {
    "promptlint-ai": "./bin/cli.js"
  },
  "files": [
    "src/",
    "bin/",
    "examples/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "pack:check": "npm pack --dry-run",
    "server": "node --env-file-if-exists=.env server/index.js",
    "configure:server": "node scripts/configure-server.js"
  },
  "keywords": [
    "ai",
    "prompt",
    "lint",
    "offline",
    "prompt-engineering",
    "cli"
  ],
  "author": "Het Javiya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hetjaviya15/PromptLint.git"
  },
  "homepage": "https://github.com/hetjaviya15/PromptLint#readme",
  "bugs": {
    "url": "https://github.com/hetjaviya15/PromptLint/issues"
  },
  "dependencies": {
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "groq-sdk": "^1.6.0",
    "ora": "^10.0.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  }
}
